# Copia aquest fitxer a manual_settings.env (NO es versiona) i omple'l.
# Bateria apart, NOMÉS manual (el bin/test normal no la llança):
#   bin/test -s genweb6.organs --tests-pattern='^manual$' --test-file-pattern='^manual_'
# Els tests que no tinguin la configuració necessària se salten.

# --- Serveis de firma de PRE (valors del registry de PRE, IFirmaDocumentalSettings)
GDOC_URL=
GDOC_USER=
GDOC_HASH=
GDOC_FONS_ID=
CODIEXPEDIENT_URL=
CODIEXPEDIENT_APIKEY=
PORTAFIRMES_URL=
PORTAFIRMES_APIKEY=
COPIESAUTENTIQUES_URL=
COPIESAUTENTIQUES_APIKEY=
SIGNATURACSV_URL=
SIGNATURACSV_APIKEY=
# Sèrie documental de proves a gDOC PRE
GDOC_SERIE_TEST=
# Autor dels documents a gDOC (a producció és el camp "author" de l'òrgan)
GDOC_AUTHOR_TEST=
# Usuari (commonName) que constarà com a signant a Portafirmes PRE
PRE_SIGNANT=

# --- Usuari UPC real (LDAP), proves en LOCAL (no es toca cap Plone de PRE)
# Login real contra ldap.upc.edu; l'email s'obté de l'LDAP (no es configura).
# Els correus es capturen i s'imprimeixen per consola, no s'envien.
LOCAL_USER=
LOCAL_PASSWORD=
# Contrasenya del bind de ldapUPC (la de [ldapconfig] bindpasswd del buildout).
# Si es deixa buida, s'agafa la variable d'entorn ldapbindpasswd.
LDAP_BIND_PASSWORD=
